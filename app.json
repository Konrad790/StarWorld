{
  "expo": {
    "name": "StarWorld",
    "slug": "starworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "starworld",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.starworld.app"
    },
    "android": {
      "package": "com.starworld.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "assetBundlePatterns": [
      "assets/**"
    ]
  }
}
