{
  "expo": {
    "name": "StarWorld",
    "slug": "starworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "starworld",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.starworld.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.starworld.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/**"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa037476-f8a1-418a-9dd4-cab6a3aa9f28"
      }
    }
  }
}
